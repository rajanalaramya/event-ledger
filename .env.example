# Safe local/dev placeholders only. Copy to `.env` for local overrides.
# Never commit real secrets.

# Service ports
GATEWAY_PORT=8080
ACCOUNT_PORT=8081

# Inter-service URL (Compose overrides this for containers)
EVENTLEDGER_ACCOUNT_SERVICE_BASE_URL=http://localhost:8081

# Optional OpenTelemetry exporter (leave empty to disable remote export)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional Grafana admin password for local observability profile only
GF_SECURITY_ADMIN_PASSWORD=change-me-locally
