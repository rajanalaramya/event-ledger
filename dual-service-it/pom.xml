<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example.eventledger</groupId>
        <artifactId>event-ledger</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>dual-service-it</artifactId>
    <name>Dual Service Integration Tests</name>
    <description>Optional Failsafe suite that starts real Gateway and Account Service processes</description>

    <properties>
        <dual.it.gateway.port>18080</dual.it.gateway.port>
        <dual.it.account.port>18081</dual.it.account.port>
        <dual.it.workdir>${project.build.directory}/dual-service-it</dual.it.workdir>
        <dual.it.logs>${dual.it.workdir}/logs</dual.it.logs>
        <dual.it.account.db>${dual.it.workdir}/data/account/account-db</dual.it.account.db>
        <dual.it.gateway.db>${dual.it.workdir}/data/gateway/gateway-db</dual.it.gateway.db>
        <account.service.jar>${project.basedir}/../account-service/target/account-service-${project.version}.jar</account.service.jar>
        <event.gateway.jar>${project.basedir}/../event-gateway/target/event-gateway-${project.version}.jar</event.gateway.jar>
    </properties>

    <dependencies>
        <!-- Reactor ordering: both service JARs must be packaged before this module's ITs. -->
        <dependency>
            <groupId>com.example.eventledger</groupId>
            <artifactId>account-service</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.example.eventledger</groupId>
            <artifactId>event-gateway</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-dual-service-it-dirs</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${dual.it.workdir}/data" quiet="true"/>
                                <mkdir dir="${dual.it.logs}"/>
                                <mkdir dir="${dual.it.workdir}/data/account"/>
                                <mkdir dir="${dual.it.workdir}/data/gateway"/>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>cleanup-dual-service-it-data</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${dual.it.workdir}/data" quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.bazaarvoice.maven.plugins</groupId>
                <artifactId>process-exec-maven-plugin</artifactId>
                <version>0.9</version>
                <executions>
                    <execution>
                        <id>start-account-service</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>start</goal>
                        </goals>
                        <configuration>
                            <name>account-service</name>
                            <workingDir>${dual.it.workdir}</workingDir>
                            <waitForInterrupt>false</waitForInterrupt>
                            <healthcheckUrl>http://127.0.0.1:${dual.it.account.port}/health</healthcheckUrl>
                            <waitAfterLaunch>90</waitAfterLaunch>
                            <processLogFile>${dual.it.logs}/account-service.log</processLogFile>
                            <arguments>
                                <argument>java</argument>
                                <argument>-jar</argument>
                                <argument>${account.service.jar}</argument>
                                <argument>--server.port=${dual.it.account.port}</argument>
                                <argument>--spring.datasource.url=jdbc:h2:file:${dual.it.account.db};MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH;AUTO_SERVER=FALSE</argument>
                                <argument>--management.otlp.tracing.export.enabled=false</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>start-event-gateway</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>start</goal>
                        </goals>
                        <configuration>
                            <name>event-gateway</name>
                            <workingDir>${dual.it.workdir}</workingDir>
                            <waitForInterrupt>false</waitForInterrupt>
                            <healthcheckUrl>http://127.0.0.1:${dual.it.gateway.port}/health</healthcheckUrl>
                            <waitAfterLaunch>90</waitAfterLaunch>
                            <processLogFile>${dual.it.logs}/event-gateway.log</processLogFile>
                            <arguments>
                                <argument>java</argument>
                                <argument>-jar</argument>
                                <argument>${event.gateway.jar}</argument>
                                <argument>--server.port=${dual.it.gateway.port}</argument>
                                <argument>--eventledger.account-service.base-url=http://127.0.0.1:${dual.it.account.port}</argument>
                                <argument>--eventledger.rate-limit.enabled=false</argument>
                                <argument>--spring.datasource.url=jdbc:h2:file:${dual.it.gateway.db};MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH;AUTO_SERVER=FALSE</argument>
                                <argument>--management.otlp.tracing.export.enabled=false</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stop-dual-service-it-processes</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>stop-all</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <!-- Disable Spring Boot parent default Failsafe execution to avoid running ITs twice. -->
                    <execution>
                        <id>default</id>
                        <configuration>
                            <skipITs>true</skipITs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>dual-service-it</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <dual.it.gateway.port>${dual.it.gateway.port}</dual.it.gateway.port>
                                <dual.it.account.port>${dual.it.account.port}</dual.it.account.port>
                                <dual.it.gateway.log>${dual.it.logs}/event-gateway.log</dual.it.gateway.log>
                                <dual.it.account.log>${dual.it.logs}/account-service.log</dual.it.account.log>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
